@startuml
!pragma layout smetana
skinparam defaultFontName "Noto Sans CJK SC"
title 09 本地原型部署图 - 结构图
node "用户终端" as Client {
  artifact "浏览器\n顾客/酒店/平台界面" as Browser
}
node "本地应用主机\n配置在验收时记录" as AppHost {
  node "单应用进程" as App {
    artifact "模块化单体\nAPI及领域服务" as Server
    artifact "TimeoutWorker" as Timeout
    artifact "FailureAuditWorker" as Failure
  }
  folder "持久磁盘目录" as Disk {
    database "failure_audit_queue.sqlite\nWAL及同步持久化" as Queue
  }
}
node "数据库服务" as DBHost {
  database "PostgreSQL" as DB
  folder "持久数据卷" as Volume
}
Browser --> Server : HTTP(S), 每请求鉴权
Server --> DB : 业务与成功审计本地事务
Timeout --> Server : 内部系统身份调用过期处理
Server --> Queue : 失败日志数据库故障时
Failure --> Queue : 重启后恢复领取
Failure --> DB : operationId唯一补记
DB --> Volume : 持久化业务/任务/审计
note bottom of AppHost
队列不能放临时目录或仅存内存.
本图不承诺灾难备份或恢复时长SLA.
end note
@enduml
