@startuml
!pragma layout smetana
skinparam defaultFontName "Noto Sans CJK SC"
title 01 酒店预订系统用例图 - 行为图
left to right direction
actor "顾客" as Customer
actor "酒店工作人员" as Staff
actor "平台管理员" as Admin
actor "持久任务调度" as Timer
rectangle "酒店预订系统" {
  usecase "组合查询酒店房型" as Search
  usecase "创建预订" as Create
  usecase "相同行程提醒与决定" as Duplicate
  usecase "查看本人订单" as Mine
  usecase "修改预订" as Modify
  usecase "取消预订" as Cancel
  usecase "确认订单" as Confirm
  usecase "办理入住与退房" as Stay
  usecase "维护日库存/价格/停售" as Inventory
  usecase "清洁/维修实体房" as Rooms
  usecase "管理酒店及临时停业" as Hotels
  usecase "管理人员授权" as Grants
  usecase "订单查询与统计" as Reports
  usecase "查询审计日志" as Logs
  usecase "按版本超时取消" as Expire
}
Customer --> Search
Customer --> Create
Customer --> Mine
Customer --> Modify
Customer --> Cancel
Duplicate ..> Create : <<extend>>\n不同请求存在相同行程
Staff --> Confirm
Staff --> Stay
Staff --> Inventory
Staff --> Rooms
Staff --> Reports : 仅授权酒店
Admin --> Hotels
Admin --> Grants
Admin --> Reports : 全平台
Admin --> Logs
Timer --> Expire
note bottom of Create
同请求重放返回原订单;
待确认起占全部住宿晚.
end note
note bottom of Hotels
停业待协调是正交标记,
不增加订单状态.
end note
@enduml
