@startuml
!pragma layout smetana
skinparam defaultFontName "Noto Sans CJK SC"
title 03 模块化单体组件图 - 结构图
component "顾客/酒店/平台界面" as UI
package "模块化单体" {
  component "HTTP控制器" as API
  component "Authorizer\n身份与对象授权" as Auth
  component "CatalogQuery\n酒店组合查询" as Catalog
  component "BookingService\n预订交易" as Booking
  component "InventoryService\n逐晚库存与售卖" as Inventory
  component "PricePolicy / ExpiryPolicy" as Policies
  component "FrontDeskService\n实体房与入住退房" as Desk
  component "HotelService\n酒店与停业" as Hotel
  component "ReportingService\n查询统计" as Report
  component "AuditService" as Audit
  component "UnitOfWork / Repositories" as UOW
  component "TimeoutWorker" as Timeout
  component "FailureAuditWorker" as Failure
}
database "PostgreSQL\n业务/任务/成功及失败审计" as DB
database "本地SQLite持久失败队列" as Queue
UI --> API
API --> Auth
API --> Catalog
API --> Booking
API --> Desk
API --> Hotel
API --> Report
Booking --> Inventory
Booking --> Policies
Booking --> Audit
Desk --> Inventory
Desk --> Audit
Hotel --> Audit
Inventory --> Audit
Booking --> UOW
Desk --> UOW
Hotel --> UOW
Inventory --> UOW
Audit --> UOW : 成功使用同一事务
Catalog --> DB : 只读
Report --> DB : 只读授权范围
UOW --> DB
Timeout --> Booking : expire(order, version)
Audit --> Queue : 失败日志数据库故障
Failure --> Queue : 领取持久事件
Failure --> DB : operationId唯一补记
@enduml
