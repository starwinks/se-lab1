@startuml
!pragma layout smetana
skinparam defaultFontName "Noto Sans CJK SC"
title 02 酒店预订领域类图 - 结构图
hide empty members
class "顾客 User" as User {
  +id
}
class "酒店 Hotel" as Hotel {
  +id
  +temporarilyClosed
}
class "房型 RoomType" as RoomType {
  +id
  +maxGuests
}
class "逐晚库存 DailyInventory" as DailyInventory {
  +night
  +total
  +occupied
  +validateDelta(delta)
}
class "订单 Booking" as Booking {
  +state
  +version
  +waitingSince
  +coordinationRequired
  +confirm(t)
  +revise(t)
  +cancel(reason)
}
class "逐晚价格 NightPrice" as NightPrice {
  +version
  +night
  +unitPrice
}
class "逐晚占用 InventoryAllocation" as InventoryAllocation {
  +night
  +quantity
}
class "实体房 Room" as Room {
  +state
  +assign()
  +finishCleaning()
}
class "入住分配 RoomAssignment" as RoomAssignment {
  +checkedInAt
  +checkedOutAt
}
class "超时任务 TimeoutJob" as TimeoutJob {
  +targetVersion
  +dueAt
  +isDue(t)
}
class "协调记录 CoordinationCase" as CoordinationCase {
  +reason
  +resolution
}
class BookingService {
  +create()
  +modify()
  +confirm()
  +cancel()
  +expire()
}
class InventoryService {
  +lockDays()
  +applyNetDelta()
}
class FrontDeskService {
  +checkIn()
  +checkOut()
}
class AuditService {
  +writeSuccess()
  +recordFailure()
}
Hotel "1" *-- "0..*" RoomType
RoomType "1" *-- "0..*" DailyInventory
RoomType "1" -- "0..*" Room
User "1" -- "0..*" Booking
Booking "*" --> "1" RoomType
Booking "1" *-- "1..*" NightPrice
Booking "1" -- "0..*" InventoryAllocation
InventoryAllocation "*" --> "1" DailyInventory
Booking "1" -- "0..*" RoomAssignment : 历史
Room "1" -- "0..*" RoomAssignment
Booking "1" -- "1..*" TimeoutJob
Hotel "1" -- "0..*" CoordinationCase
CoordinationCase "*" -- "*" Booking
BookingService ..> Booking
BookingService ..> InventoryService
BookingService ..> AuditService
FrontDeskService ..> Booking
FrontDeskService ..> Room
FrontDeskService ..> AuditService
note bottom of Booking
只使用五态; version为修订/确认周期版本.
同订单最多一条未结束实体房分配.
end note
@enduml
